# Template for config/passwords.yaml, which holds the server's secrets and is
# never committed (it is in .gitignore).
#
# Quick start: run `tool/setup_dev_secrets.sh` from the repo root. It copies
# this file to config/passwords.yaml, replaces every <random> with a fresh
# random value, and writes the matching database password to
# pinne_server/.env for docker compose.
#
# Any value can instead come from an environment variable named
# SERVERPOD_PASSWORD_<key>, e.g. SERVERPOD_PASSWORD_database. Use env vars in
# staging and production.

shared:
  # Gemini organizing (optional). Obtain a Gemini Developer API key from
  # Google AI Studio. Keep this commented out to use deterministic rules only.
  # Never commit a real value. The setup script leaves this placeholder intact.
  # geminiApiKey: '<set-locally>'

  # Google sign-in (optional). Leave commented out until real OAuth
  # credentials exist; the server then starts with Google sign-in disabled and
  # email sign-in still works.
  #
  # To enable: create an OAuth "Web application" client in Google Cloud
  # Console, download its JSON and paste it here as a single-quoted string.
  # The Flutter app also needs --dart-define=GOOGLE_CLIENT_ID=... and
  # --dart-define=GOOGLE_SERVER_CLIENT_ID=... (see README.md).
  #
  # googleClientSecret: '{"web":{"client_id":"<your-web-client-id>.apps.googleusercontent.com","client_secret":"<your-client-secret>","redirect_uris":["http://localhost:8080/auth/google/callback"]}}'

  # Google Calendar (optional, not built yet). The planner reports the Google
  # route as "not configured" until this exists, and as "not built yet" after;
  # it never claims to have read a Google calendar. Device calendars and .ics
  # export need no credentials.
  #
  # googleCalendarClientSecret: '{"web":{"client_id":"...","client_secret":"..."}}'

  # Optional SMTP delivery for staging and production. Development and tests
  # keep printing verification codes to the server console. Set at least host
  # and from email; username/password must either both be present or both be
  # omitted for an authenticated or local relay respectively. STARTTLS is used
  # by default; set smtpSsl to 'true' only for implicit TLS (commonly port 465).
  # These may instead be supplied as PINNE_SMTP_* environment variables.
  # smtpHost: 'smtp.example.com'
  # smtpPort: '587'
  # smtpUsername: '<set-locally>'
  # smtpPassword: '<set-locally>'
  # smtpFromEmail: 'hello@example.com'
  # smtpFromName: 'Pinne'
  # smtpSsl: 'false'

development:
  # Must equal PINNE_DEV_DB_PASSWORD in pinne_server/.env (docker compose).
  database: '<random>'
  serviceSecret: '<random>'
  emailSecretHashPepper: '<random>'
  jwtHmacSha512PrivateKey: '<random>'
  jwtRefreshTokenHashPepper: '<random>'
  # Local judge account. Run `dart run bin/main.dart --seed-demo` once the
  # development database is running. The account starts with no Pinne saves.
  demoAccountEmail: 'judge@pinne.local'
  demoAccountPassword: '<random>'

# Tests run against an embedded PostgreSQL that Serverpod manages itself.
test:
  database: '<random>'
  emailSecretHashPepper: '<random>'
  jwtHmacSha512PrivateKey: '<random>'
  jwtRefreshTokenHashPepper: '<random>'
  demoAccountEmail: 'judge@pinne.test'
  demoAccountPassword: '<random>'

# Staging and production secrets belong in the deployment environment
# (SERVERPOD_PASSWORD_* variables), not in a file on a laptop.
staging:
  database: '<set-in-environment>'
  serviceSecret: '<set-in-environment>'
  emailSecretHashPepper: '<set-in-environment>'
  jwtHmacSha512PrivateKey: '<set-in-environment>'
  jwtRefreshTokenHashPepper: '<set-in-environment>'
  demoAccountEmail: '<set-in-environment>'
  demoAccountPassword: '<set-in-environment>'

production:
  database: '<set-in-environment>'
  serviceSecret: '<set-in-environment>'
  emailSecretHashPepper: '<set-in-environment>'
  jwtHmacSha512PrivateKey: '<set-in-environment>'
  jwtRefreshTokenHashPepper: '<set-in-environment>'
  demoAccountEmail: '<set-in-environment>'
  demoAccountPassword: '<set-in-environment>'
